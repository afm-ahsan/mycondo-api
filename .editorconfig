root = true

# All files
[*]
indent_style = space
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# C#
[*.cs]
indent_size = 4
max_line_length = 140

# C# language conventions
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:warning
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_properties = true:silent
csharp_prefer_braces = true:warning
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning

# .NET formatting
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Naming — private fields camelCase with underscore prefix
dotnet_naming_style.camel_case_with_underscore.capitalization = camel_case
dotnet_naming_style.camel_case_with_underscore.required_prefix = _

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =

dotnet_naming_rule.private_fields_should_begin_with_underscore.severity = error
dotnet_naming_rule.private_fields_should_begin_with_underscore.symbols  = private_fields
dotnet_naming_rule.private_fields_should_begin_with_underscore.style    = camel_case_with_underscore

# Naming — interfaces start with I
dotnet_naming_style.interface_prefix.capitalization = pascal_case
dotnet_naming_style.interface_prefix.required_prefix = I
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_rule.interfaces_must_start_with_i.severity = error
dotnet_naming_rule.interfaces_must_start_with_i.symbols  = interfaces
dotnet_naming_rule.interfaces_must_start_with_i.style    = interface_prefix

# Severity overrides
dotnet_diagnostic.CA1062.severity = none      # Validate args (FluentValidation handles this at boundary)
dotnet_diagnostic.CA2007.severity = none      # ConfigureAwait not needed in ASP.NET Core
dotnet_diagnostic.CA1303.severity = none      # Don't pass literals as localized parameters
dotnet_diagnostic.CA1716.severity = none      # Reserved keyword conflict (e.g. .Shared) — acceptable for our domain
dotnet_diagnostic.CS1591.severity = suggestion

# JSON / YAML / config
[*.{json,yml,yaml}]
indent_size = 2

# XML / csproj / props
[*.{xml,csproj,props,targets}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false   # trailing 2 spaces = hard line break in Markdown

# PowerShell
[*.{ps1,psm1}]
indent_size = 4
