# Auto-detect text files; normalize line endings on commit (LF), check out CRLF on Windows
* text=auto eol=crlf

# Force LF for shell scripts and Linux-only files
*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf

# Force CRLF for Windows-only
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binary files — never normalize
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.tar       binary
*.tar.gz    binary
*.7z        binary
*.dll       binary
*.exe       binary
*.snk       binary

# Large file diff hints
*.cs        diff=csharp
*.csproj    merge=union
*.sln       text eol=crlf merge=union
*.slnx      text eol=crlf merge=union
*.props     merge=union
