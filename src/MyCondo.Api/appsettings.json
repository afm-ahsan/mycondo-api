{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithCorrelationId" ],
    "Properties": {
      "Application": "mycondo-api"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=mycondo_dev;Username=mycondo_app;Password=mycondo_dev",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "https://api.mycondo.app",
    "Audience": "https://app.mycondo.app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4219"
    ]
  },
  "AllowedHosts": "*"
}
