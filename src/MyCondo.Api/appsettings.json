{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithCorrelationId" ],
    "Properties": {
      "Application": "mycondo-api"
    }
  },
  "ConnectionStrings": {
    // No default value here by design — this is safe/shared structure only, not a real credential.
    // Local development supplies the real value via appsettings.Development.json (see that file and
    // mycondo-docs ADR-023 for the current, temporary MVP credential decision). A future
    // Staging/Production appsettings.<Environment>.json — or the production secret-management
    // mechanism ADR-023 requires before then — must supply its own value; this key intentionally
    // stays absent here so a missing environment-specific value fails clearly at startup instead of
    // silently resolving to a placeholder that looks like a real connection string.
    "Redis": "localhost:6379"
  },
  "Storage": {
    "RootPath": "App_Data/uploads"
  },
  "Jwt": {
    "Issuer": "https://api.condobd.com",
    "Audience": "https://api.condobd.com",
    "PlatformAudience": "https://api.condobd.com",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4219",
      "http://condobd.com"
    ]
  },
  "AllowedHosts": "*"
}
