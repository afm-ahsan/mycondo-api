# Docker Compose local development (ADR-016 model) — see docker-compose.yml and README.md's
# Developer Environment Matrix. Copy this file to `.env` (gitignored) and fill in a real value.
# This is unrelated to the native-PostgreSQL path, which sets its connection string directly in
# appsettings.Development.json (temporary MVP decision, mycondo-docs ADR-023) — see README.md's
# "Native PostgreSQL" quickstart.

# Bootstrap/DDL role (mycondo_migrator) password for the Dockerized PostgreSQL container.
POSTGRES_PASSWORD=
