# ============================
# PostgreSQL / local database artifacts
# (docker-compose uses a named volume for postgres data, so no bind-mounted
#  data directory is expected in-repo — these guard against one appearing.
#  Seed scripts under db/init/ are intentionally tracked and NOT ignored.)
# ============================
/pgdata/
/db/data/
*.sql.bak
*.dump
*.backup

